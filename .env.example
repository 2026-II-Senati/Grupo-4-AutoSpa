# Configuración de Docker Compose.
# Copia este archivo como .env en la RAÍZ del repositorio y cambia las contraseñas.
# El .env no se sube a GitHub. Aquí solo hay valores de ejemplo.
#
# Ojo: este archivo configura los contenedores (MySQL y la aplicación).
# La modalidad local con npm se configura aparte, en backend/.env (ver docs/instalacion.md).

# Puerto de tu computadora conectado al 3306 del contenedor MySQL
MYSQL_PORT=3307

# Puerto de tu computadora para abrir AutoSpa en Docker (React y /api en la misma URL)
APP_PORT=8080

# Base de datos y usuario de la aplicación (los usa el backend, dentro y fuera de Docker)
MYSQL_DATABASE=autospa
MYSQL_USER=autospa_app
MYSQL_PASSWORD=cambia_esta_contrasena

# Contraseña del administrador root (solo para administrar MySQL, no para el backend)
MYSQL_ROOT_PASSWORD=cambia_esta_contrasena_root

# Variables adicionales de la aplicación (por ejemplo, de autenticación):
# no van aquí. Créalas en un archivo .env.app en la raíz, con el formato NOMBRE=valor.
# Compose lo pasa al contenedor app si existe; tampoco se sube a GitHub.
