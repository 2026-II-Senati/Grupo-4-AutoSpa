# Copia este archivo como backend/.env y cambia los valores por los de tu MySQL local.
# El archivo .env no se sube a GitHub. Aquí solo hay valores de ejemplo.

# Puerto del backend
PORT=3001

# Conexión a MySQL 8.0.16 o posterior
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=autospa
DB_USER=autospa_app
DB_PASSWORD=cambia_esta_contrasena

# Muestra en consola las consultas SQL (true/false)
DB_LOGGING=false
